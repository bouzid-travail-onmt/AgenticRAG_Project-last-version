
@'
# ==========================================
# SECRETS AND ENVIRONMENT VARIABLES
# ==========================================
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets/
credentials/
*_secret*
*_credentials*
*service-account*.json

# ==========================================
# NODE.JS / NPM / YARN / PNPM
# ==========================================
node_modules/
.npm/
.pnpm-store/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
.nyc_output/

# ==========================================
# FRONTEND BUILDS AND CACHES
# ==========================================
.cache/
.parcel-cache/
.vite/
.turbo/
.next/
.nuxt/
.output/
.svelte-kit/
.angular/
dist/
build/
coverage/
storybook-static/
*.tsbuildinfo

# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
pip-wheel-metadata/
wheels/
share/python-wheels/

# Python virtual environments
venv/
.venv/
env/
ENV/
virtualenv/
.python-version

# Python packaging
build/
dist/
.eggs/
*.egg
*.egg-info/
MANIFEST

# Jupyter
.ipynb_checkpoints/

# ==========================================
# AI / ML / RAG / MODEL ARTIFACTS
# ==========================================
# Uncomment if these files are generated and should not be versioned
# models/
# checkpoints/
# embeddings/
# vector_store/
# chroma_db/
# faiss_index/
# *.safetensors
# *.gguf
# *.onnx
# *.pt
# *.pth
# *.bin

# ==========================================
# DATABASES AND LOCAL DATA
# ==========================================
*.sqlite
*.sqlite3
*.db
*.db-journal
instance/
data/local/
uploads/
tmp/
temp/

# ==========================================
# LOGS AND RUNTIME FILES
# ==========================================
logs/
*.log
*.pid
*.pid.lock
pids/
*.seed
*.stackdump

# ==========================================
# EDITORS AND IDEs
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ==========================================
# OPERATING SYSTEM
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
._*

# ==========================================
# TESTS AND TEMPORARY FILES
# ==========================================
.npmrc.local
.eslintcache
.stylelintcache
*.tmp
*.temp
*.bak
*.orig
*.rej

# ==========================================
# DOCKER / LOCAL OVERRIDES
# ==========================================
.env.docker
docker-compose.override.yml

# ==========================================
# LOCAL CERTIFICATES AND KEYS
# ==========================================
certs/
certificates/
*.crt
*.cer
*.der

# ==========================================
# LARGE GENERATED ARCHIVES
# Review before committing archives
# ==========================================
# *.zip
# *.7z
# *.rar
# *.tar
# *.tar.gz
'@ | Set-Content -Path .gitignore -Encoding utf8
